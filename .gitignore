# ============================================
# CADRE .gitignore
# ============================================

# ── Large Data (DO NOT push to GitHub) ──
data/
replay_buffer/

# ── Checkpoints: exclude large model files, keep small configs ──
checkpoints/llava-v1.5-7b/
checkpoints/**/*.safetensors
checkpoints/**/*.pt
checkpoints/**/*.bin
checkpoints/fisher_matrices/

# ── Keep these checkpoint files (small) ──
!checkpoints/pipeline_state.json
!checkpoints/lora_adapters/*/adapter_config.json
!checkpoints/lora_adapters/*/README.md

# ── Outputs: exclude logs, keep results ──
outputs/logs/
# Keep: outputs/cadre_bench/, outputs/visualizations/, outputs/*.pptx, outputs/*.pdf

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual Environments ──
venv/
env/
.env
.venv
cadre_env/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──
*.log
wandb/
runs/

# ── Kaggle ──
kaggle.json

# ── Misc ──
*.zip
*.tar.gz
*.tgz
*.7z
*.rar
